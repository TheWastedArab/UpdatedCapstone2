# Copy to backend/.env and fill in. Every setting in app/config.py can be set here with the BT_ prefix.

BT_ENVIRONMENT=development
# PostgreSQL connection (DC-04). Create the role and database first; see the README.
BT_DATABASE_URL=postgresql+psycopg://bugtracker:CHANGE_ME@localhost:5432/bugtracker
# Optional: run the test suite against PostgreSQL instead of in-memory SQLite.
# BT_TEST_DATABASE_URL=postgresql+psycopg://bugtracker:CHANGE_ME@localhost:5432/bugtracker_test

# Signing key for session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BT_SECRET_KEY=CHANGE_ME

# Development only: return the email verification code in the API response,
# so accounts can be created without a mail server. Never enable in production.
BT_EXPOSE_VERIFICATION_CODE=true

# Email (FR-16): console prints messages to the server log; smtp sends them.
BT_EMAIL_BACKEND=console
# BT_EMAIL_FROM=bugtracker@example.org
# BT_SMTP_HOST=smtp.example.org
# BT_SMTP_PORT=587
# BT_SMTP_USER=
# BT_SMTP_PASSWORD=

# Push alerts for the highest severity through a self-hosted ntfy server (Section 3.3.2). Empty disables.
# BT_NTFY_URL=http://localhost:8080
# BT_NTFY_TOKEN=

# Triage settings (also changeable at runtime by an Administrator, NFR-14)
# BT_DUPLICATE_THRESHOLD=0.70
# BT_SEVERITY_LABELS=Low,Medium,High,Critical
# BT_COLD_START_THRESHOLD=100
