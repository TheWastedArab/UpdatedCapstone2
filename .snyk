# Snyk Code policy (repository root). The backend's dependency policy is backend/.snyk.
# Test fixtures and the development tools below sign in with fixed passwords to a temporary
# test database or the seeded demo database; they are not credentials and are never shipped,
# so they are left out of the secrets scan.
exclude:
  global:
    - backend/tests/**
    - docs/usability/**
    - extension/scripts/**
